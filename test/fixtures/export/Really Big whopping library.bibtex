@article{GolledgePanzeriZhengEtAl03,
  title = {Correlations, Feature-Binding and Population Coding in Primary Visual Cortex.},
  author = {Golledge, Huw D. R. and Panzeri, Stefano and Zheng, Fashan and Pola, Gianni and Scannell, Jack W. and Giannikopoulos, Dimitrios V. and Mason, Roger J. and Tov{\'e}e, Martin J. and Young, Malcolm P.},
  year = 2003,
  month = jun,
  journal = {Neuroreport},
  volume = {14},
  eprint = {12802200},
  eprinttype = {pubmed},
  pages = {1045--1050},
  note = {Between 89 and 96\% of the information was carried by firing rates, correlations contributed 4-11\% extra information. The distribution across the population of either correlation strength or correlation information did not co-vary systematically with changes in perception predicted by Gestalt psychology. These results suggest that firing rates, rather than correlations, are the main element of the population code for feature binding in primary visual cortex.}
}

