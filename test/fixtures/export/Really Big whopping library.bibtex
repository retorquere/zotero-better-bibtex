@article{MorrisSchenkTweedieEtAl90,
  title = {Ibotenate {{Lesions}} of {{Hippocampus}} and/or {{Subiculum}}: {{Dissociating Components}} of {{Allocentric Spatial Learning}}},
  author = {Morris, R. G. M. and Schenk, F. and Tweedie, F. and Jarrard, L. E.},
  year = 1990,
  month = jan,
  journal = {European Journal of Neuroscience},
  volume = {2},
  pages = {1016--1028},
  note = {Shows that preoperatively trained rats become very accurate after postoperative retraining, but only postoperative training does not result in such accuracy. One way to think about this is to suppose that the lesioned rat is forced to develop alternative nonhippocampal strategies for retrieving spatial information stored in cortex, but this is accurate only if such information is already there to be retrieved. Also could be just that there is heightened specificity, since the postop-only rats get the general location right, just not the exact right place. However, subiculum lesions blocked this!}
}

